# SIGIL OS Environment Configuration Example
# Copy this file to .env and customize for your environment

# API Configuration
API_HOST=127.0.0.1
API_PORT=8080
API_ENABLE_CORS=true

# Model Configuration
MODEL_PROVIDER=local
MODEL_NAME=qwen-7b
MODEL_PATH=~/.sigil-os/models/qwen-7b
MODEL_DOWNLOAD_IF_MISSING=true

# UI Configuration
UI_THEME=dark
UI_ICON_PACK=default
UI_AVATAR_STYLE=realistic

# Dream Weaving Configuration
DREAM_WEAVING_ENABLED=true
DREAM_WEAVING_MAX_GENERATIONS=10
DREAM_WEAVING_AUTO_APPROVE_MUTATIONS=false

# Quest 3 Configuration
QUEST_ENABLED=false
QUEST_AUTO_CONNECT=true

# Database Configuration
DATABASE_PATH=~/.local/share/sigil-os/sigil.db

# Logging Configuration
LOG_LEVEL=info
LOG_FORMAT=json

# Development Configuration
DEBUG=false
PROFILE=release
