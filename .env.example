# SIGIL OS Environment Variables
# Copy this file to .env and fill in your values

# Server Configuration
PORT=8080
RUST_LOG=info

# Database (if using external database)
# DATABASE_URL=postgresql://user:password@localhost/sigil

# Super Brain Configuration
SUPERBRAIN_ENABLED=true

# Model Configuration (if using external models)
# OPENAI_API_KEY=your_openai_api_key
# ANTHROPIC_API_KEY=your_anthropic_api_key

# Feature Flags
ENABLE_DREAM_WEAVING=true
ENABLE_AVATAR=true
ENABLE_SUPERBRAIN=true

# Deployment Configuration (set by hosting platforms)
# These are typically set automatically by Render, Belmo, etc.
# DO NOT commit actual values to git
