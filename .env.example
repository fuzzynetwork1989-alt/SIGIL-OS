# SIGIL OS Environment Variables

# API Configuration
API_HOST=127.0.0.1
API_PORT=8080

# OpenAI API Key (for cloud-based AI)
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic API Key (optional)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Model Configuration
DEFAULT_MODEL=gpt-4
TEMPERATURE=0.7
MAX_TOKENS=2048

# Super Brain Configuration
ENABLE_SUPER_BRAIN=true
SUPER_BRAIN_CONTEXT_SIZE=131072

# Logging
RUST_LOG=info
