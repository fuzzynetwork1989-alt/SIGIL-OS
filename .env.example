# SIGIL OS Environment Variables
# Copy this file to .env and fill in your values

# Server Configuration
PORT=8080
RUST_LOG=info

# Database (if using external database)
# DATABASE_URL=postgresql://user:password@localhost/sigil

# Super Brain Configuration
SUPERBRAIN_ENABLED=true

# Model Configuration
# LLM backend: auto | ollama | openai (auto prefers local Ollama)
# SIGIL_LLM_PROVIDER=auto
# Local Ollama (OpenAI-compatible) endpoint and default model
# SIGIL_OLLAMA_HOST=http://localhost:11434/v1
# SIGIL_OLLAMA_MODEL=qwen2:0.5b
# OPENAI_API_KEY=your_openai_api_key
# ANTHROPIC_API_KEY=your_anthropic_api_key

# Feature Flags
ENABLE_DREAM_WEAVING=true
ENABLE_AVATAR=true
ENABLE_SUPERBRAIN=true

# Deployment Configuration (set by hosting platforms)
# These are typically set automatically by Render, etc.
# DO NOT commit actual values to git
