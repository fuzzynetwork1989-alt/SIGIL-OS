{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://contracts.nexora.omega/schemas/cognitive-process.json",
  "title": "CognitiveProcess",
  "description": "Schema for NEXORA Omega Cognitive Process - the durable unit of cognition",
  "type": "object",
  "required": [
    "id",
    "identity_ref",
    "workspace_ref",
    "tenant_ref",
    "intent",
    "state",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid",
      "description": "Unique identifier for the cognitive process"
    },
    "identity_ref": {
      "type": "string",
      "format": "uuid",
      "description": "Reference to the user or system identity that owns this process"
    },
    "workspace_ref": {
      "type": "string",
      "format": "uuid",
      "description": "Reference to the workspace this process belongs to"
    },
    "tenant_ref": {
      "type": "string",
      "format": "uuid",
      "description": "Reference to the tenant/organization"
    },
    "intent": {
      "type": "string",
      "description": "The high-level intent or goal of this cognitive process"
    },
    "goals": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "description": { "type": "string" },
          "priority": { "type": "integer", "minimum": 1, "maximum": 10 },
          "status": { "type": "string", "enum": ["pending", "in_progress", "completed", "blocked"] }
        }
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "beliefs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "claim": { "type": "string" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "evidence": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "working_memory_refs": {
      "type": "array",
      "items": { "type": "string", "format": "uuid" }
    },
    "long_term_memory_refs": {
      "type": "array",
      "items": { "type": "string", "format": "uuid" }
    },
    "world_state_refs": {
      "type": "array",
      "items": { "type": "string", "format": "uuid" }
    },
    "self_state": {
      "type": "object",
      "properties": {
        "lifecycle_state": {
          "type": "string",
          "enum": [
            "dormant",
            "observing",
            "estimating",
            "allocating",
            "retrieving",
            "hypothesizing",
            "planning",
            "simulating",
            "requesting_approval",
            "acting",
            "verifying",
            "learning",
            "consolidating",
            "ready",
            "paused",
            "cancelled",
            "snapshotted",
            "terminated"
          ]
        },
        "attention_allocation": {
          "type": "object",
          "properties": {
            "focus_areas": {
              "type": "array",
              "items": { "type": "string" }
            },
            "priority_weights": {
              "type": "object",
              "additionalProperties": { "type": "number" }
            }
          }
        }
      }
    },
    "reasoning_budget": {
      "type": "object",
      "properties": {
        "token_limit": { "type": "integer" },
        "token_used": { "type": "integer" },
        "model_call_limit": { "type": "integer" },
        "model_calls_used": { "type": "integer" }
      }
    },
    "model_binding": {
      "type": "object",
      "properties": {
        "model_id": { "type": "string" },
        "model_version": { "type": "string" },
        "allowed_model_classes": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "capability_set": {
      "type": "array",
      "items": { "type": "string", "format": "uuid" }
    },
    "taint_context": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["external", "model_generated", "unverified", "sensitive", "trusted"]
      }
    },
    "execution_plan": {
      "type": "object",
      "properties": {
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "action": { "type": "string" },
              "parameters": { "type": "object" },
              "dependencies": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "simulation_results": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "step_id": { "type": "string" },
              "predicted_outcome": { "type": "string" },
              "confidence": { "type": "number" }
            }
          }
        }
      }
    },
    "provenance_chain": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source": { "type": "string" },
          "transformation": { "type": "string" },
          "timestamp": { "type": "string", "format": "date-time" }
        }
      }
    },
    "checkpoints": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "timestamp": { "type": "string", "format": "date-time" },
          "state_snapshot": { "type": "object" }
        }
      }
    },
    "recovery_policy": {
      "type": "object",
      "properties": {
        "max_retries": { "type": "integer" },
        "retry_delay": { "type": "string" },
        "fallback_strategy": { "type": "string" }
      }
    },
    "operator_controls": {
      "type": "object",
      "properties": {
        "pausable": { "type": "boolean" },
        "cancellable": { "type": "boolean" },
        "inspectable": { "type": "boolean" },
        "revocable": { "type": "boolean" }
      }
    },
    "state": {
      "type": "string",
      "enum": [
        "dormant",
        "observing",
        "estimating",
        "allocating",
        "retrieving",
        "hypothesizing",
        "planning",
        "simulating",
        "requesting_approval",
        "acting",
        "verifying",
        "learning",
        "consolidating",
        "ready",
        "paused",
        "cancelled",
        "snapshotted",
        "terminated"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}