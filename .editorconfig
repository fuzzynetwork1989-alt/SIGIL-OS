# EditorConfig for SIGIL OS
# https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{rs,toml,yaml,yml,md}]
indent_style = space
indent_size = 4

[*.{bat,cmd,ps1}]
end_of_line = crlf

[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

[{package.json,Cargo.lock}]
indent_style = space
indent_size = 2
