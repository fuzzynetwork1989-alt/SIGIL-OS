{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm build",
  "devCommand": "pnpm dev",
  "installCommand": "pnpm install",
  "framework": "nextjs",
  "regions": ["iad1"],
  "env": {
    "NEXT_PUBLIC_API_URL": {
      "description": "API endpoint for NEXORA Omega backend",
      "value": "https://api.nexora.omega"
    },
    "NEXT_PUBLIC_APP_URL": {
      "description": "Public URL for the web application",
      "value": "https://nexora.omega"
    }
  },
  "build": {
    "env": {
      "NEXT_PUBLIC_API_URL": "https://api.staging.nexora.omega",
      "NEXT_PUBLIC_APP_URL": "https://staging.nexora.omega"
    }
  }
}