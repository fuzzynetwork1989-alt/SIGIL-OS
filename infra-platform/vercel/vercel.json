{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm build",
  "devCommand": "pnpm dev",
  "installCommand": "pnpm install",
  "framework": "nextjs",
  "regions": ["iad1"],
  "env": {
    "NEXT_PUBLIC_API_URL": {
      "description": "API endpoint for the SIGIL OS backend",
      "value": "https://sigil-os-api.onrender.com"
    },
    "NEXT_PUBLIC_APP_URL": {
      "description": "Public URL for the web application",
      "value": "https://sigil-os.vercel.app"
    }
  },
  "build": {
    "env": {
      "NEXT_PUBLIC_API_URL": "https://sigil-os-api.onrender.com",
      "NEXT_PUBLIC_APP_URL": "https://sigil-os.vercel.app"
    }
  }
}
