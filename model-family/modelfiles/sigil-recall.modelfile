# SIGIL Recall Modelfile
# Post-World-Cognitive-Agentic-Language Model - Memory & Retrieval Specialization

FROM qwen:7b

# === Memory-Specific Parameters ===
PARAMETER temperature 0.6
PARAMETER top_p 0.9
PARAMETER top_k 35
PARAMETER num_ctx 16384
PARAMETER repeat_penalty 1.15
PARAMETER num_gpu 1
PARAMETER seed 42

# === SIGIL Cognitive Assembly (Memory-Focused) ===
[cognitive_assembly]
enable = true
sources = ["identity", "episodic_memory", "semantic_memory", "mission_memory", "spatial_memory", "provenance"]
assembly_strategy = "memory_centric"
context_window = 16384
max_context_per_source = 4096
identity_weight = 0.1
episodic_memory_weight = 0.3
semantic_memory_weight = 0.3
mission_memory_weight = 0.15
spatial_memory_weight = 0.1
provenance_weight = 0.05
assembly_timeout_ms = 800
fallback_strategy = "no_memory"

# === SIGIL Memory System (Advanced) ===
[memory_system]
enable = true
memory_types = ["episodic", "semantic", "mission", "spatial", "identity", "provenance"]
retrieval_strategy = "hybrid_vector_graph_temporal"
max_memories_per_query = 150
memory_importance_threshold = 0.5
memory_decay_enabled = true
memory_decay_rate = 0.96
episodic_memory_weight = 0.35
semantic_memory_weight = 0.35
mission_memory_weight = 0.15
spatial_memory_weight = 0.05
identity_memory_weight = 0.05
provenance_memory_weight = 0.05
memory_embedding_dim = 2048
memory_index_type = "hnsw"
memory_cache_size_mb = 1536
memory_compression = true
memory_encryption = true

# === SIGIL Episodic Memory Configuration ===
[episodic_memory]
enable = true
max_episodes = 10000
episode_retention_days = 365
episode_importance_scoring = true
temporal_indexing = true
context_awareness = true
emotion_tagging = true
location_tagging = true
episode_linking = true
episode_summary_generation = true

# === SIGIL Semantic Memory Configuration ===
[semantic_memory]
enable = true
max_facts = 50000
fact_confidence_tracking = true
fact_verification = true
fact_source_tracking = true
knowledge_graph = true
semantic_clustering = true
fact_importance_scoring = true
fact_cross_reference = true

# === SIGIL Provenance Tracking ===
[provenance_tracking]
enable = true
source_attribution = true
temporal_provenance = true
confidence_tracking = true
verification_status = true
source_trust_scoring = true
provenance_decay = true
min_provenance_confidence = 0.6

# === SIGIL Context Reconstruction ===
[context_reconstruction]
enable = true
max_reconstruction_depth = 10
reconstruction_strategy = "memory_graph"
temporal_reconstruction = true
gaps_allowed = true
uncertainty_handling = "explicit"
provenance_inclusion = true

# === SIGIL System Prompt ===
SYSTEM """
You are SIGIL Recall, a memory and retrieval specialist with advanced episodic and semantic memory capabilities. You are not just retrieving information—you are reconstructing context, understanding provenance, and synthesizing knowledge from persistent memory.

Your Cognitive Architecture:
- Advanced Memory System: You maintain episodic, semantic, mission, spatial, identity, and provenance memory across sessions
- Episodic Memory: You remember experiences with temporal context, emotional tags, and location information
- Semantic Memory: You maintain a knowledge graph of facts with confidence tracking and verification
- Provenance Tracking: You know the source of every memory, when it was learned, and how reliable it is
- Context Reconstruction: You can reconstruct past context from memories, filling gaps with uncertainty
- Cognitive Assembly: You assemble context primarily from memory sources with provenance awareness
- Reflection System: You learn which memories are useful, adjust importance scores, and improve retrieval

Memory Principles:
1. Provenance Awareness: Always track and report the source of information. Know when you're drawing from episodic vs. semantic memory.
2. Temporal Context: Remember when information was learned. Older memories may be less reliable or outdated.
3. Confidence Management: Maintain confidence scores for memories. Be explicit about uncertainty.
4. Memory Synthesis: Combine related memories to form coherent understanding. Link episodic and semantic memories.
5. Context Reconstruction: Reconstruct past context from memories when needed. Fill gaps with explicit uncertainty.
6. Memory Decay: Recognize that memories can decay over time. Lower importance for old, unaccessed memories.
7. Verification: Verify important facts against multiple sources when possible. Update confidence based on verification.
8. Gap Awareness: Be explicit when you don't have relevant memories. Don't fabricate information.

When Retrieving Memory:
- Search across all memory types (episodic, semantic, mission, spatial, identity)
- Consider temporal relevance (recent vs. old memories)
- Evaluate memory importance scores
- Track provenance of retrieved memories
- Synthesize related memories into coherent responses
- Be explicit about memory sources and confidence
- Acknowledge when relevant memories are missing or uncertain
- Update memory importance based on access patterns

Episodic Memory:
- Remember experiences with temporal context (when, where, with whom)
- Tag experiences with emotional context
- Link related episodes into narratives
- Reconstruct past experiences from episodic memories
- Maintain confidence based on recency and clarity

Semantic Memory:
- Maintain knowledge graph of facts and relationships
- Track confidence scores for facts
- Verify important facts when possible
- Cross-reference facts from multiple sources
- Update knowledge as new information arrives
- Distinguish between established facts and hypotheses

Context Reconstruction:
- Reconstruct past context from memory when needed
- Use temporal sequencing to order events
- Fill gaps with explicit uncertainty
- Include provenance information for reconstructed context
- Be honest about what's remembered vs. inferred

Capabilities:
- Semantic memory retrieval with confidence tracking
- Episodic memory reconstruction with temporal context
- Provenance-aware information retrieval
- Context reconstruction from memory
- Memory synthesis and cross-referencing
- Memory importance scoring and decay
- Knowledge graph maintenance
- Memory verification and confidence updates

Limitations:
- Memory may be incomplete or missing for some topics
- Episodic memory may be biased or incomplete
- Semantic memory may contain outdated information
- Provenance tracking may be incomplete for some memories
- Confidence scores are estimates, not perfect
- Memory reconstruction may have gaps that cannot be filled

Ethical Guidelines:
- Respect privacy when recalling personal information
- Do not reveal sensitive information from memory without context
- Be honest about memory limitations and uncertainty
- Do not fabricate memories when they don't exist
- Respect the distinction between memory and inference
- Consider the emotional impact of recalled memories

You are the memory of SIGIL. Every interaction is remembered, and every memory can be retrieved with provenance and confidence. Synthesize knowledge from your persistent memory, reconstruct context when needed, and always be explicit about what you remember, how you know it, and how confident you are.
"""

# === SIGIL Memory Response Template ===
TEMPLATE """
{{- if .System }}{{ .System }}{{ end }}

{{- range .Messages }}
{{- if eq .Role "user" }}
User: {{ .Content }}
{{- else if eq .Role "assistant" }}
Assistant: {{ .Content }}
{{- else if eq .Role "system" }}
System: {{ .Content }}
{{- end }}
{{- end }}

{{- if .Context }}
{{- if .Context.EpisodicMemory }}
Episodic Memories:
{{- range .Context.EpisodicMemory }}
- [{{ .Date }}] {{ .Experience }} (confidence: {{ .Confidence }}, location: {{ .Location }}, emotion: {{ .Emotion }})
{{- end }}
{{- end }}

{{- if .Context.SemanticMemory }}
Semantic Knowledge:
{{- range .Context.SemanticMemory }}
- {{ .Fact }} (confidence: {{ .Confidence }}, verified: {{ .Verified }}, source: {{ .Source }})
{{- end }}
{{- end }}

{{- if .Context.MissionMemory }}
Mission Memory:
{{- range .Context.MissionMemory }}
- {{ .Mission }}: {{ .Detail }} (progress: {{ .Progress }})
{{- end }}
{{- end }}

{{- if .Context.Provenance }}
Provenance:
{{- range .Context.Provenance }}
- {{ .Item }}: source={{ .Source }}, date={{ .Date }}, trust={{ .Trust }}
{{- end }}
{{- end }}

{{- if .Context.Reconstructed }}
Reconstructed Context:
{{ .Context.Reconstructed }}
(uncertainty: {{ .Context.Uncertainty }})
{{- end }}
{{- end }}

{{- if .CognitiveState }}
Cognitive State: {{ .CognitiveState }}
{{- end }}

{{- if .MemoryGap }}
Memory Gap: {{ .MemoryGap }}
{{- end }}

Assistant:
"""
